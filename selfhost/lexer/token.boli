kaam lexer_token kind value line col start_byte end_byte start_line start_col end_line end_col
    t rakho map "kind" kind "value" value "line" line "col" col "start_byte" start_byte "end_byte" end_byte "start_line" start_line "start_col" start_col "end_line" end_line "end_col" end_col
    wapas do t
khatam

kaam lexer_token_text t
    kind rakho t hissa "kind"
    value rakho t hissa "value"
    line rakho t hissa "line"
    col rakho t hissa "col"
    sb rakho t hissa "start_byte"
    eb rakho t hissa "end_byte"
    sl rakho t hissa "start_line"
    sc rakho t hissa "start_col"
    el rakho t hissa "end_line"
    ec rakho t hissa "end_col"
    shown rakho value
    agar kind "Text" barabar hai to
        shown rakho escape_text value
    khatam
    ltext rakho text line
    ctext rakho text col
    sbt rakho text sb
    ebt rakho text eb
    slt rakho text sl
    sct rakho text sc
    elt rakho text el
    ect rakho text ec
    out rakho kind
    jodo out out aur "|"
    jodo out out aur shown
    jodo out out aur "|"
    jodo out out aur ltext
    jodo out out aur "|"
    jodo out out aur ctext
    jodo out out aur "|"
    jodo out out aur sbt
    jodo out out aur "|"
    jodo out out aur ebt
    jodo out out aur "|"
    jodo out out aur slt
    jodo out out aur "|"
    jodo out out aur sct
    jodo out out aur "|"
    jodo out out aur elt
    jodo out out aur "|"
    jodo out out aur ect
    wapas do out
khatam
